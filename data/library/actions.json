{
  "id": "actions",
  "version": 1,
  "title": "动作资料库",
  "description": "记录游戏中的可执行动作、动作分类、等级要求、场景限制、目标状态要求及变量影响。",
  "type": "action_library",
  "aiVisible": true,
  "playerVisible": true,

  "categories": [
    {
      "id": "clothing_control",
      "name": "服装控制",
      "description": "对目标所穿服饰进行脱除、卷起或侧拨的操作。",
      "enabled": true
    },
    {
      "id": "pose",
      "name": "姿势控制",
      "description": "对目标进行整体姿态的调整或肢体拖拽定位。",
      "enabled": true
    },
    {
      "id": "basic_action",
      "name": "基础动作",
      "description": "使用双手对目标进行的最基础、最直接的身体抚触与调弄。",
      "enabled": true
    },
    {
      "id": "item_control",
      "name": "道具操作",
      "description": "使用SP拍子、羽毛、玩具、插入道具及束缚绳对目标施加刺激。",
      "enabled": true
    },
    {
      "id": "medicine_control",
      "name": "药物操作",
      "description": "给目标使用特殊药物以改变其敏感度、昏睡状态或生理状态。",
      "enabled": true
    },
    {
      "id": "special",
      "name": "特殊操作",
      "description": "包括高潮/射精定位、跨越排斥项等高级权限操作。",
      "enabled": true
    }
  ],

