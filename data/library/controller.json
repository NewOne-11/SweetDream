    "daytimeControl": {
      "enabled": true,
      "stages": [
        {
          "minLevel": 1,
          "maxLevel": 8,
          "name": "熟睡之夜",
          "availablePeriods": ["night_sleep"],
          "rules": {
            "wakeMultiplier": 1.0,
            "description": "最基础安全的夜间潜行玩法，在目标进入熟睡后由电波自动诱导进入控制。"
          }
        },
        {
          "minLevel": 9,
          "maxLevel": 12,
          "name": "小憩突袭",
          "availablePeriods": ["night_sleep", "nap_time"],
          "rules": {
            "wakeMultiplier": 1.2,
            "durationLimitHours": 2,
            "description": "午休或小憩时段亦可短暂入侵，时长限于1-2小时内，苏醒值增长系数为1.2倍。"
          }
        },
        {
          "minLevel": 13,
          "maxLevel": 14,
          "name": "独处电波",
          "availablePeriods": ["night_sleep", "nap_time", "solitude_daytime"],
          "rules": {
            "wakeMultiplier": 3.0,
            "forceLowIntensity": true,
            "description": "目标清醒但独处时可开启。苏醒度增幅至3倍。操作力度强制锁死低档，引起目标在清醒状态下产生极度羞红、自我怀疑。"
          }
        },
        {
          "minLevel": 15,
          "maxLevel": 17,
          "name": "全时段隐蔽",
          "availablePeriods": ["night_sleep", "nap_time", "solitude_daytime", "public_spaces"],
          "rules": {
            "wakeMultiplier": 1.0,
            "respectSceneRestrictions": true,
            "description": "任何时间地点皆可开启。在公共人群密集场所强制受场景内置风险限制限制。"
          }
        },
        {
          "minLevel": 18,
          "maxLevel": null,
          "name": "自由傀儡",
          "availablePeriods": ["anytime"],
          "rules": {
            "wakeMultiplier": 1.5,
            "targetResistanceReduced": true,
            "description": "目标由于身心顺从并形成强烈的生理条件反射，抗性大幅度下降，全天候可无压力高频调弄。"
          }
        }
      ]
    },

    "dualValueSystem": {
      "description": "通过精密的操作调节快感，你想推满高潮值，但每一步都在推高苏醒值。数值首先触顶100%的一方判定胜出。",
      "orgasmValue": {
        "name": "高潮值",
        "min": 0,
        "max": 100,
        "onReachMax": {
          "trigger": "target_forced_orgasm",
          "settlement": true,
          "resetTo": 0
        },
        "afterSettlement": {
          "sensitivityMultiplier": 1.5,
          "durationSeconds": 30,
          "description": "高潮结算完成归零后，苏醒值不回落。目标进入30秒的高度敏感期，期间高潮积攒速度额外提升50%。"
        }
      },
      "wakeValue": {
        "name": "苏醒值",
        "min": 0,
        "max": 100,
        "onReachMax": {
          "trigger": "target_wakes_up",
          "currentControlEnds": true,
          "description": "苏醒值一经满值，目标会在当夜瞬间惊醒，本轮控制调教当即强行中断结束。"
        }
      }
    },

