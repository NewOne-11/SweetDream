{
  "id": "controller",
  "version": "4.0.0",
  "title": "操控者系统规则库与状态模式",
  "description": "游戏核心运行规则库。包含静态机制设计与动态数据状态机，支持AI与系统状态转换判定。",
  "type": "system_rule",
  "aiVisible": true,
  "playerVisible": true,
  "debugMode": false,

  "visibilityRules": {
    "description": "这是操控者视角规则库。部分内容属于系统隐藏规则，仅供AI及系统后台调用。",
    "controller": true,
    "target": false,
    "system": true
  },

  "rulePriorities": {
    "description": "全局规则冲突判定优先级。高优先级规则自动拦截并覆盖低优先级规则。",
    "order": [
      { "priority": 1, "id": "system_hard_rules", "name": "系统硬限制", "canBeBypassed": false },
      { "priority": 2, "id": "meeting_safety_rules", "name": "见面安全规则", "canBeBypassed": false },
      { "priority": 3, "id": "target_rejected_content_protection", "name": "目标拒绝项保护", "canBeBypassed": false },
      { "priority": 4, "id": "level_twenty_override_exception", "name": "Lv.20无视排斥项例外特权", "canBeBypassed": true },
      { "priority": 5, "id": "scene_compatibility_rules", "name": "场景操作限制", "canBeBypassed": false },
      { "priority": 6, "id": "item_compatibility_rules", "name": "道具操作限制", "canBeBypassed": false },
      { "priority": 7, "id": "ordinary_modifiers", "name": "基础数值修正", "canBeBypassed": true }
    ],
    "overrideRule": "Lv.20无视排斥项例外特权（Priority 4）不可覆盖见面安全规则（Priority 2）或系统硬限制（Priority 1）。"
  },

  "staticRules": {
    "levelSystem": {
      "name": "操控者等级系统",
      "minLevel": 1,
      "publicMaxLevel": 20,
      "hiddenMaxLevel": 25,
      "hardMaxLevel": 25,
      "hiddenLevelSupport": true,
      "hiddenLevelRule": {
        "startsAt": 21,
        "progression": "xp_and_story_unlock",
        "description": "Lv.21-25属于隐藏等级，需在Lv.20经验满额且完成特定主线追踪剧情后方可晋升。升级仍需100经验值，但着重体现后台数据波动及隐藏线索曝光。"
      }
    },

    "experienceGain": {
      "source": "orgasm_settlement",
      "formula": "settled_orgasm_value",
      "conversionRate": 1.0,
      "onSettlement": {
        "experienceGain": 100,
        "description": "每次高潮值达到100%并触发结算时，操控者直接获得100经验值（XP）。"
      }
    },

    "multiplierPolicy": {
      "orgasmMultipliers": "multiplicative",
      "maxTotalMultiplier": 5.0,
      "wakeMultipliers": "stage_multiplier_is_replacement",
      "description": "高潮值采用叠乘计算，但最终综合乘数硬性封顶于5.0倍，防止数值崩坏。苏醒值乘数采用时段替换机制：若处于白天特定操控时段，其固有的wakeMultiplier直接覆盖并替换基础规则中的时段乘数，不进行重复叠乘。"
    },

