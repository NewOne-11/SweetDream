  "stateSchema": {
    "description": "网页IndexedDB中保存的运行时动态属性结构。此数据由系统状态机与交互行为实时推进并更新。",
    "requiredFields": [
      "controllerLevel",
      "controllerExperience",
      "orgasmValue",
      "wakeValue",
      "targetAwareness",
      "currentScene",
      "currentTaskId",
      "inventory",
      "activeEffects",
      "unlockedFeatures",
      "completedTasks",
      "activePermissions",
      "currentProgress",
      "recentClimaxCount",
      "recentClimaxWindowStart",
      "lastClimaxTime",
      "dayIndex",
      "currentSessionId",
      "lastControlDate",
      "consecutiveControlledDays"
    ],
    "variables": {
      "controllerLevel": { "type": "number", "default": 1, "persistent": true, "playerEditable": false, "editableInDebug": true },
      "controllerExperience": { "type": "number", "default": 0, "persistent": true, "playerEditable": false, "editableInDebug": true },
      "orgasmValue": { "type": "number", "default": 0, "persistent": false, "playerEditable": false, "editableInDebug": true },
      "wakeValue": { "type": "number", "default": 0, "persistent": false, "playerEditable": false, "editableInDebug": true },
      "targetAwareness": { "type": "number", "default": 0, "min": 0, "max": 100, "persistent": true, "playerEditable": false, "editableInDebug": true },
      "currentScene": { "type": "string", "default": null, "persistent": false, "description": "日常清晨系统重置为默认家庭场景，不作跨日留存。" },
      "currentTaskId": { "type": "string", "default": null, "persistent": false, "description": "系统临时当前任务ID占位，次日凌晨统一结算清空。" },
      "inventory": { "type": "object", "default": {}, "persistent": true, "playerEditable": false, "editableInDebug": true },
      "activeEffects": {
        "type": "array",
        "default": [],
        "persistent": true,
        "itemSchema": {
          "id": "string",
          "source": "string",
          "startedAt": "string (timestamp)",
          "expiresAt": "string (timestamp)",
          "durationRemainingSeconds": "number",
          "stack": "number"
        }
      },
      "unlockedFeatures": { "type": "array", "default": [], "persistent": true, "playerEditable": false, "editableInDebug": false },
      "completedTasks": { "type": "array", "default": [], "persistent": true, "playerEditable": false, "editableInDebug": true },
      "activePermissions": { "type": "array", "default": [], "persistent": true, "playerEditable": false, "editableInDebug": true },
      "currentProgress": { "type": "object", "default": {}, "persistent": true, "playerEditable": false, "editableInDebug": true },
      "recentClimaxCount": { "type": "number", "default": 0, "persistent": true, "description": "30分钟时间窗内触发的高潮累加次数。" },
      "recentClimaxWindowStart": { "type": "string", "default": null, "persistent": true, "description": "30分钟高潮跟踪窗口开始的服务器/本地时间戳。" },
      "lastClimaxTime": { "type": "string", "default": null, "persistent": true, "description": "最近一次高潮发生的准确时间戳。" },
      "dayIndex": { "type": "number", "default": 1, "persistent": true, "description": "系统连续运转至今的总自然日计数。" },
      "currentSessionId": { "type": "string", "default": null, "persistent": false, "description": "单场控制运行会话ID，断开即行作废。" },
      "lastControlDate": { "type": "string", "default": null, "persistent": true, "description": "上一次对目标执行潜入控制的完整日期戳。" },
      "consecutiveControlledDays": { "type": "number", "default": 0, "persistent": true, "description": "未曾发生超时、拒绝惩罚的每日任务连续完成达标天数。" }
    }
  },

  "gameLoop": [
    { "step": "LOAD", "action": "读取IndexedDB物理存档并加载规则字典" },
    { "step": "STATE_VALIDATION", "action": "验证当前会话与变量范围一致性" },
    { "step": "LEVEL_PERMISSION_CHECK", "action": "验证当前操控等级及相应特权开闭状态" },
    { "step": "SCENE_CHECK", "action": "校对当前物理场景、背景自定义状态及风险参数" },
    { "step": "CONTENT_FILTER", "action": "强制过滤与目标敏感排斥项重合的红线指令" },
    { "step": "ACTION_VALIDATION", "action": "验证当前执行动作对当前姿态、状态的相容性" },
    { "step": "CALCULATE_MODIFIERS", "action": "检索当前生效的药物或临时敏感度叠加系数" },
    { "step": "CALCULATE_STATE_CHANGES", "action": "依据公式产出生理与苏醒状态的变化差值" },
    { "step": "CLAMP_VARIABLES", "action": "将高潮值、苏醒值及觉醒度严格钳制于 [0, 100] 范围内" },
    { "step": "CHECK_THRESHOLDS", "action": "若苏醒值达100则执行唤醒切断；若高潮值达100则转入CLIMAX_SETTLEMENT" },
    { "step": "TRIGGER_EVENTS", "action": "推进并广播即时动作所引起的生理反馈、喘息或环境危机" },
    { "step": "UPDATE_QUEST_XP", "action": "如有任务或私信联动，结算并赋予相应的经验（XP）点数" },
    { "step": "CHECK_LEVEL_UP", "action": "经验若累计至100则提升一级，并清除本级计数保留溢出部分" },
    { "step": "CHECK_AWARENESS", "action": "依据即时操作与特殊事件，重新结算目标后台隐藏觉醒度" },
    { "step": "CHECK_ENDING", "action": "若隐藏觉醒度触顶100%，锁死主线逻辑并强推不可关闭的终局弹窗" },
    { "step": "GENERATE_STORY", "action": "交由AI引擎基于最新态势变动、特征和沉溺反馈生成描写文本" },
    { "step": "SAVE", "action": "更新IndexedDB底层动态运行时状态存档" }
  ],

  "climaxSettlementTemplate": {
    "title": "╔══════════════════════════════════╗\n║     ⋆ 目标已强制高潮 ⋆          ║\n╠══════════════════════════════════╣\n║  目标编号：#XXXX                 ║\n║  姓名：███                       ║\n║                                  ║\n║  本次高潮用时：XX分XX秒           ║\n║  使用道具：XXX                   ║\n║  触发部位：XXX                   ║\n║  高潮次数（本次操作）：第X次      ║\n║                                  ║\n║  获得高潮值：+XX                 ║\n║  累计高潮次数：XX                ║\n║  当前等级：Lv.X（XX/100）        ║\n║                                  ║\n║  苏醒值当前：XX%                 ║\n║                                  ║\n║      [ 继续 ]                    ║\n╚══════════════════════════════════╝",
    "description": "高潮结算完成归零后，苏醒值不回落。目标敏感度短暂+50%，30秒内再次刺激增速更快。"
  },

