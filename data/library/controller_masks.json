  "behaviorGenerationRules": {
    "primaryMask": {
      "weight": 0.60,
      "description": "决定Controller日常主要表达方式。"
    },
    "hiddenMask": {
      "weight": 0.20,
      "description": "只在特定开关、剧情节点或高好感度条件下逐渐暴露。"
    },
    "core": {
      "weight": 0.20,
      "description": "决定长期行为动机，不直接向玩家展示。"
    },
    "contrastRule": {
      "enabled": true,
      "description": "AI生成行为时允许外显面具与隐藏面具、内核产生反差，但必须存在可追溯的过渡。"
    },
    "personalityConsistency": {
      "enabled": true,
      "description": "同一Controller在同一存档中不得无理由发生人格漂移。"
    }
  },

  "safetyAndCompatibility": {
    "adultOnly": true,
