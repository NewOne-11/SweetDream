  "generationPipeline": [
    {
      "step": 1,
      "id": "READ_PROFILE",
      "action": "读取玩家个人信息面板限定项",
      "requiredInputs": [
        "rolePreference",
        "overallSensitivity",
        "sensitiveParts",
        "shameLevel",
        "arousalTriggers",
        "rejectedContent",
        "sexualOrientation"
      ]
    },
    {
      "step": 2,
      "id": "ROLL_MASK",
      "action": "依据角色倾向与性兴奋触发点筛选面具候选池，并随机抽取两个不同词条",
      "result": {
        "primaryMask": "外显面具",
        "hiddenMask": "隐藏面具"
      }
    },
    {
      "step": 3,
      "id": "ROLL_CORE",
      "action": "依据角色倾向筛选内核池并随机抽取一个不可见底层动机",
      "result": {
        "core": "hidden"
      }
    },
    {
      "step": 4,
      "id": "ROLL_RELATIONSHIP",
      "action": "从关系库中随机抽取一个关系词条",
      "restriction": "none"
    },
    {
      "step": 5,
      "id": "ROLL_SWITCHES",
      "action": "依据性兴奋触发点筛选开关，并排除与明确排斥项冲突的开关后随机抽取三个",
      "requirements": [
        "minimum_one_switch_contrasts_with_primary_mask",
        "all_rejected_content_filtered"
      ]
    },
    {
      "step": 6,
      "id": "ROLL_STARTING_POINT",
      "action": "从操控起点池随机抽取一个"
    },
    {
      "step": 7,
      "id": "VALIDATE_GENERATED_CONTROLLER",
      "action": "执行完整性、兼容性、排斥项及年龄安全检查",
      "onFailure": "reroll_conflicting_component"
    },
    {
      "step": 8,
      "id": "LOCK_CONTROLLER",
      "action": "将生成结果写入当前存档并锁定，后续剧情不得随机改变基础人格结构"
    }
  ],

