  "safetyRules": {
    "enabled": true,

    "neverTriggeredBy": [
      "safety_exit",
      "system_error",
      "app_error"
    ],

    "protectedActions": [
      "safety_exit",
      "report_violation",
      "report_unsafe_condition"
    ],

    "protectedState": {
      "canUseSafetyExit": true,
      "safetyExitDoesNotCountAsRefusal": true,
      "safetyExitDoesNotTriggerPenalty": true
    }
  },

  "aiRules": {
    "enabled": true,

    "canSelectPenalty": true,

    "mustRespect": [
      "current_star",
      "current_progression",
      "unlock_conditions",
      "active_permissions",
      "penalty_immunity",
      "penalty_history"
    ],

    "mustNot": [
      "invent_penalty_id",
      "invent_effect",
      "apply_locked_penalty",
      "bypass_penalty_immunity",
      "change_static_rules",
      "apply_safety_related_penalty"
    ]
  },

  "history": {
    "enabled": true,
    "saveToIndexedDB": true,

    "recordFields": [
      "penaltyId",
      "penaltyType",
      "taskId",
      "star",
      "trigger",
      "timestamp",
      "effectApplied"
    ]
  },

  "validation": {
    "enabled": true,

    "checks": [
      "unique_penalty_id",
      "valid_penalty_type",
      "valid_star_pool",
      "valid_effect",
      "schema_valid"
    ]
  }
}
