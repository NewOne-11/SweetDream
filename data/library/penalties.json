  "system": {
    "enabled": true,

    "selection": {
      "method": "weighted_random",
      "allowDuplicate": false,
      "respectUnlockConditions": true
    },

    "triggers": {
      "taskRefused": true,
      "taskTimeout": true,
      "systemViolation": false,
      "safetyExit": false
    },

    "immunity": {
      "enabled": true,
      "itemId": "ticket_penalty_immunity"
    }
  },

