      "days": 30,
      "condition": "无超时且无拒绝记录",
      "reward": "APP界面主题变化及私信风格变化"
    }
  ],


  "finalChoice": {
    "trigger": {
      "field": "awareness",
      "operator": ">=",
      "value": 100
    },

    "lockedAfterChoice": true,

    "options": [
