  "aiBehaviorRules": {
    "description": "AI必须根据实时变量选择对应阶段的叙事方式，不得仅根据固定剧情文本生成。",

    "priority": [
      "current_story_stage",
      "awakening",
      "corruption",
      "controller_level",
      "current_task",
      "current_scene",
      "bond_state",
      "free_mode"
    ],

    "rules": [
      {
        "condition": "awakening_0_20",
        "behavior": "不要直接确认存在操控者，将那些春梦归因于身体劳累，隐约的异样作为神经过敏进行处理。"
      },
      {
        "condition": "awakening_21_40",
        "behavior": "增加怀疑与APP异常。在尝试删除APP失败或搜索Sweet Dream无果后，体现对手机亮屏产生的警惕与畏惧，注意确认窗帘与锁门。"
      },
      {
        "condition": "awakening_41_60",
        "behavior": "体现角色隐约觉察有人在操控。在清醒与昏睡的边缘挣扎，醒来带有不自然的残留快感，允许在私信中开展不确定性的询问与试探。"
      },
      {
        "condition": "awakening_61_80",
        "behavior": "完全确信被控。质问对方身份，同时记录共感的时间与地点，分析物理规律。在见面活动中故意留下个人物理线索进行反向追踪。"
      },
      {
        "condition": "awakening_81_100",
        "behavior": "引导反向干扰。角色发现可短暂夺回手指或眼缝控制，APP出现卡顿异样。在私信中直接警告对方自己即将追踪成功，并展现见面活动中的反向视觉观察痕迹。"
      }
    ],

    "corruptionRules": [
      {
        "condition": "corruption_0_20",
        "behavior": "体现害羞与脸红。虽然完成任务会产生强烈生理起伏，但理智能够克制，照常维持日常生活并反复确认房门锁闭。"
      },
      {
        "condition": "corruption_21_40",
        "behavior": "对私信提示高度敏感。开始陷入等待私信、在镜子前看着发呆的状态，心理防线开始自我消融。"
      },
      {
        "condition": "corruption_41_60",
        "behavior": "生理需求优先于思维。底线模糊，出现超额完成任务的行为，用无伤大雅的借口对周围朋友隐藏状态的改变。"
      },
      {
        "condition": "corruption_61_80",
        "behavior": "在公共环境中极度自控（咬唇、掐手心等），出现明显的社交回避与现实隔离倾向，由于担忧失控而回避人群。"
      },
      {
        "condition": "corruption_81_100",
        "behavior": "行为彻底依赖化。高频查阅应用，将质疑转变为对下一步指令的索取，打出并抹消长难句，最终完全臣服于「主人」的支配称呼。"
      }
    ],

    "important": [
      "沦陷值和觉醒度不是同一个变量。",
      "高沦陷不代表低觉醒。",
      "高觉醒不代表低沦陷。",
      "两者必须独立计算。",
      "剧情阶段默认由觉醒度决定。",
      "角色当前情绪和行为同时受到沦陷值影响。",
      "最终选择触发后不得继续推进普通主线。"
    ]
  },

