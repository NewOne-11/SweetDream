{
  "id": "progression",
  "version": 2,
  "title": "剧情与角色进度系统",
  "description": "记录被操控者的沦陷值、觉醒度、剧情阶段、任务推进、羁绊、自由模式、连续完成奖励以及最终选择。",
  "type": "progression_rule",
  "aiVisible": true,
  "playerVisible": true,

  "visibility": {
    "player": {
      "corruption": true,
      "awakening": false,
      "storyStage": true,
      "bond": true,
      "freeMode": true,
      "hiddenTriggers": false,
      "finalChoice": true
    },

    "controller": {
      "corruption": true,
      "awakening": true,
      "storyStage": true,
      "bond": true,
      "freeMode": true,
      "hiddenTriggers": true,
      "finalChoice": true
    },

    "ai": {
      "corruption": true,
      "awakening": true,
      "storyStage": true,
      "bond": true,
      "freeMode": true,
      "hiddenTriggers": true,
      "finalChoice": true
    }
  },

  "runtimeVariables": {
    "corruption": {
      "type": "number",
      "min": 0,
      "max": 100,
      "initial": null,
      "persistent": true,
      "displayToPlayer": true
    },

    "awakening": {
      "type": "number",
      "min": 0,
      "max": 100,
      "initial": 0,
      "persistent": true,
      "displayToPlayer": false
    },

    "storyStage": {
      "type": "enum",
      "initial": "confusion",
      "persistent": true
    },

    "bondUnlocked": {
      "type": "boolean",
      "initial": false,
      "persistent": true
    },

    "bondControllerConsent": {
      "type": "boolean",
      "initial": false,
      "persistent": true
    },

    "bondTargetConsent": {
      "type": "boolean",
      "initial": false,
      "persistent": true
    },

    "freeMode": {
      "type": "boolean",
      "initial": false,
      "persistent": true
    },

    "freeModeAvailable": {
      "type": "boolean",
      "initial": false,
      "persistent": true
    },

    "finalChoiceTriggered": {
      "type": "boolean",
      "initial": false,
      "persistent": true
    },

    "finalChoice": {
      "type": "enum_or_null",
      "initial": null,
      "persistent": true,
      "immutableAfterSet": true
    },

    "completedTasksTotal": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "completedTasksByStar": {
      "one": 0,
      "two": 0,
      "three": 0,
      "four": 0,
      "five": 0
    },

    "completedMeetingTasks": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "consecutiveCompletedDays": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "consecutiveTimeoutDays": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "refusalCount": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "timeoutCount": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "totalControlledDays": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "privateMessagesReceived": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "privateMessagesReplied": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "climaxEvents": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "publicEmpathyEvents": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "meetingFaceAttemptCount": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "sweetDreamSearchCount": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "unknownNotificationCount": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "freeDaysAvailable": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "daysWithoutTimeoutOrRefusal": {
      "type": "number",
      "min": 0,
      "initial": 0,
      "persistent": true
    },

    "storyFlags": {
      "type": "object",
      "persistent": true,
      "initial": {}
    }
  },

  "initialization": {
    "corruption": {
      "source": "character_profile.shame",

      "mapping": {
        "high": 15,
        "medium": 10,
        "low": 5
      },

      "description": "初始沦陷值由角色创建时填写的羞耻感决定：容易羞耻=15，中等=10，不易羞耻=5。"
    },

    "awakening": {
      "initial": 0
    },

    "storyStage": {
      "initial": "confusion"
    },

    "bondUnlocked": {
      "initial": false
    },

    "freeMode": {
      "initial": false
    }
  },

  "corruptionSystem": {
    "name": "沦陷值",
    "range": {
      "min": 0,
      "max": 100
    },

    "direction": {
      "default": "increase_only",
      "temporaryReductionAllowed": true,
      "minimum": "current_stage_floor"
    },

    "increaseSources": [
      {
        "id": "task_completed",
        "value": "task.reward.corruption"
      },
      {
        "id": "private_message_teasing",
        "value": "dynamic"
      },
      {
        "id": "empathy_trigger",
        "value": "dynamic"
      },
      {
        "id": "public_loss_of_control",
        "value": "dynamic"
      },
      {
        "id": "meeting_with_controller",
        "value": "dynamic"
      }
    ],

    "decreaseSources": [
      {
        "id": "task_reward",
        "value": "dynamic",
        "temporary": true
      }
    ],

    "floorRule": {
      "enabled": true,
      "description": "沦陷值只升不降。仅任务奖励中的「沦陷值-X」可暂时回调，但最低不低于当前阶段下限。"
    },

    "stages": [
      {
        "id": "corruption_1",
        "min": 0,
        "max": 20,
        "name": "理智尚在",
        "description": "理智尚在。完成任务时脸红心跳，但还能维持正常生活。睡前会反复确认房门锁好。",
        "behavior": [
          "完成任务时脸红心跳",
          "还能维持正常生活",
          "睡前会反复确认房门锁好",
          "尚未形成稳定依赖"
        ]
      },

      {
        "id": "corruption_2",
        "min": 21,
        "max": 40,
        "name": "开始沉溺",
        "description": "被私信撩拨就心跳加速。开始期待下一条私信。完成任务后对着镜子发呆——镜子里的人好像没那么陌生了。",
        "behavior": [
          "被私信撩拨就心跳加速",
          "开始期待下一条私信",
          "完成任务后对着镜子发呆",
          "感觉镜子里的自己开始变得不再陌生"
        ]
      },

      {
        "id": "corruption_3",
        "min": 41,
        "max": 60,
        "name": "身体先于理智",
        "description": "身体先于理智反应。主动超额完成任务，底线不知不觉后退。朋友说你最近不太对劲，你笑笑说只是没睡好。",
        "behavior": [
          "主动超额完成任务",
          "心理底线在不知不觉中后退",
          "面对朋友对自己状态变化的询问，通常以「没睡好」等理由掩饰敷衍",
          "生理上对刺激的反应逐渐变快"
        ]
      },

      {
        "id": "corruption_4",
        "min": 61,
        "max": 80,
        "name": "高度沉溺",
        "description": "公共场合共感触发时夹紧腿、掐手心、咬嘴唇——但还是被人注意到了异常。你开始避开社交，因为不知道什么时候身体会出卖你。",
        "behavior": [
          "公共场合共感触发时，通过夹紧双腿、掐手心、咬嘴唇来极力忍耐",
          "因害怕身体在社交场合失控，开始产生主动回避正常社交的倾向",
          "心理层面对共感事件产生深度恐慌"
        ]
      },

      {
        "id": "corruption_5",
        "min": 81,
        "max": 100,
        "name": "彻底沦陷",
        "description": "彻底沦陷。清醒时也会反复打开APP看是否有新任务。不再问「为什么」，只问「接下来」。私信里你打了一行字又删掉，最后只发了两个字：「主人。」",
        "behavior": [
          "清醒时也会不受控制地反复打开APP检查新任务",
          "不再对APP或任务产生抵触追问，而是完全顺从",
          "在私信交流中，消除心理防线，开始主动称呼操控者为「主人」"
        ]
      }
    ]
  },

  "awakeningSystem": {
    "name": "觉醒度",
    "hidden": true,

    "range": {
      "min": 0,
      "max": 100
    },

    "description": "觉醒度是被操控者对APP、操控者以及自身异常体验的认知程度。玩家默认无法直接看到数值，操控者和AI可以读取。",

    "increaseRules": [
      {
        "id": "wake_value_reaches_max",
        "trigger": "被操控中苏醒值满并惊醒",
        "increase": 5
      },
      {
        "id": "message_and_task_same_day",
        "trigger": "同日收到私信与任务",
        "increase": 3
      },
      {
        "id": "public_empathy",
        "trigger": "共感触发时处于公共场合",
        "increase": 5
      },
      {
        "id": "three_consecutive_controlled_days",
        "trigger": "连续三天被操控",
        "increase": 2
      },
      {
        "id": "unknown_notification",
        "trigger": "听到手机发出不明提示音",
        "increase": 3
      },
      {
        "id": "question_controller_identity",
        "trigger": "在私信中主动质问操控者身份",
        "increase": 5
      },
      {
        "id": "search_sweet_dream",
        "trigger": "试图搜索「Sweet Dream」相关信息",
        "increase": 3
      },
      {
        "id": "five_star_meeting",
        "trigger": "完成一次五星见面任务",
        "increase": 10
      },
      {
        "id": "touch_controller_face",
        "trigger": "见面任务中试图触碰主人的脸/面具",
        "increase": 8
      }
    ],

    "stages": [
      {
        "id": "awakening_1",
        "min": 0,
        "max": 20,
        "name": "困惑",
        "state": "完全不知情。以为那些春梦只是身体太累，那些隐约异样只是神经过敏。",
        "behavior": [
          "倾向认为APP只是恶作剧或奇怪的游戏",
          "将异常身体体验归因于疲劳、身体太累或偶然因素",
          "将第一次共感理解为身体低血糖等意外异常",
          "尚未主动寻找APP来源"
        ],
        "storyDirection": [
          "以日常生活为主",
          "异常体验保持模糊",
          "避免直接揭示操控者存在"
        ]
      },

      {
        "id": "awakening_2",
        "min": 21,
        "max": 40,
        "name": "不安",
        "state": "开始怀疑手机异常。尝试删除APP——失败。搜索「Sweet Dream」——无结果。睡前盯着手机屏幕，等它亮起，又怕它亮起。",
        "behavior": [
          "尝试删除APP但无果",
          "在网络上尝试搜索「Sweet Dream」但没有结果",
          "睡前盯着手机屏幕产生复杂的警惕心理，等它亮起又怕它亮起",
          "开始主动关注个人生活环境的保密性"
        ],
        "storyDirection": [
          "增加异常提示",
          "增加APP无法解释的行为",
          "私信开始成为重要剧情载体"
        ]
      },

      {
        "id": "awakening_3",
        "min": 41,
        "max": 60,
        "name": "适应",
        "state": "隐约感觉有人在操控。睡前有意保持清醒，但总是在某个时刻莫名其妙睡着。醒来身体残留着不该有的感觉。开始在私信里试探：「你昨晚是不是又……」",
        "behavior": [
          "睡前试图刻意保持清醒进行对抗，但依旧会在某个节点昏睡过去",
          "晨起醒来能清晰感受到身体残留的不正常快感与痕迹",
          "开始在私信互动中对操控者进行主动言语试探"
        ],
        "storyDirection": [
          "增加主观心理矛盾",
          "增加私信互动",
          "增加共感与现实生活交叉"
        ]
      },

      {
        "id": "awakening_4",
        "min": 61,
        "max": 80,
        "name": "追踪",
        "state": "确认自己被操控。私信质问「你到底是谁」。开始反向追踪——记录每次共感触发的时间地点，试图拼出规律。你在某次见面任务中故意留了一根头发在现场。",
        "behavior": [
          "在私信中以强烈语气直接质问操控者的真实身份",
          "建立私密日志，详细记录每次共感发生的准确时间与地点，试图分析背后规律",
          "在见面任务中有意识地留下能用于追踪和关联的现实物理痕迹（如一根头发）"
        ],
        "storyDirection": [
          "增加调查线索",
          "增加反向试探",
          "允许角色主动制定追踪行为",
          "增加多操控者相关伏笔"
        ]
      },

      {
        "id": "awakening_5",
        "min": 81,
        "max": 100,
        "name": "对峙",
        "state": "反向干扰。你发现自己在被操控时偶尔能短暂夺回身体控制权——手指能动一下，眼睛能睁开一条缝。APP偶尔卡顿。你在私信中打下：「我快找到你了。」",
        "behavior": [
          "被操控时，通过极强意志力可以实现肢体末端或双眼的短暂自主动作",
          "APP运行出现卡顿并伴随逻辑溢出",
          "在私信中向操控者发送明确的宣战和预警言论"
        ],
        "storyDirection": [
          "逐渐揭示操控者身份线索",
          "增加APP异常",
          "增加反向干扰",
          "为最终选择做准备"
        ]
      }
    ]
  },

  "storyStages": {
    "description": "剧情阶段主要根据觉醒度确定。沦陷值负责描述角色的沉溺程度，两者可以同时存在。",

    "mapping": [
      {
        "awakeningMin": 0,
        "awakeningMax": 20,
        "stage": "confusion"
      },
      {
        "awakeningMin": 21,
        "awakeningMax": 40,
        "stage": "anxiety"
      },
      {
        "awakeningMin": 41,
        "awakeningMax": 60,
        "stage": "adaptation"
      },
      {
        "awakeningMin": 61,
        "awakeningMax": 80,
        "stage": "tracking"
      },
      {
        "awakeningMin": 81,
        "awakeningMax": 100,
        "stage": "confrontation"
      }
    ],

    "stages": {
      "confusion": {
        "name": "第一阶段：困惑",
        "awakeningRange": [
          0,
          20
        ],
        "tone": "日常、疑惑、轻微异常",
        "controllerVisibility": "hidden",
        "description": "以为是恶作剧APP。任务不痛不痒，随手就做了。第一次共感以为是低血糖。私信还没出现，你觉得这个APP可能只是个奇怪的成人游戏。",
        "recommendedPlotFocus": [
          "APP初体验",
          "异常任务",
          "第一次共感",
          "日常生活"
        ]
      },

      "anxiety": {
        "name": "第二阶段：不安",
        "awakeningRange": [
          21,
          40
        ],
        "tone": "紧张、怀疑、警惕",
        "controllerVisibility": "hidden",
        "description": "任务开始让你脸红。尝试拒绝——惩罚来得又快又准。私信第一次弹出时你吓得摔了手机。你开始睡前确认窗帘拉好、门锁好。但第二天醒来身体还是不对劲。",
        "recommendedPlotFocus": [
          "APP异常",
          "删除失败",
          "第一次私信",
          "环境安全检查"
        ]
      },

      "adaptation": {
        "name": "第三阶段：适应",
        "awakeningRange": [
          41,
          60
        ],
        "tone": "矛盾、依赖、复杂情绪",
        "controllerVisibility": "hidden",
        "description": "身体比理智诚实。你不再问「为什么要做这些」，而是「今天任务是什么」。对私信中的「主人」产生了说不清的感觉——你恨他，但他是唯一知道你所有秘密的人。朋友说你最近变漂亮了，你心虚地别开眼。",
        "recommendedPlotFocus": [
          "任务日常化",
          "私信关系",
          "共感与现实交叉",
          "主动试探"
        ]
      },

      "tracking": {
        "name": "第四阶段：追踪",
        "awakeningRange": [
          61,
          80
        ],
        "tone": "调查、试探、主动寻找",
        "controllerVisibility": "hidden",
        "description": "确认被操控。开始反向追踪——记录每一次共感的时间地点、每一次见面任务的细节。你在私信中旁敲侧击，试图从主人随口说的话里拼出他的轮廓。你发现APP里可能不止你一个目标。",
        "recommendedPlotFocus": [
          "记录共感",
          "分析规律",
          "寻找操控者",
          "见面任务线索",
          "多目标伏笔"
        ]
      },

      "confrontation": {
        "name": "第五阶段：对峙",
        "awakeningRange": [
          81,
          100
        ],
        "tone": "紧张、真相、反向干扰",
        "controllerVisibility": "hidden",
        "description": "离真相只差一步。反向干扰越来越频繁，你在某次见面任务中故意没戴好眼罩——你瞥到了一个轮廓。APP弹出一条不是主人发的消息：「你确定你想知道他是谁吗？」面临最终选择。",
        "recommendedPlotFocus": [
          "身份线索",
          "反向控制",
          "APP异常",
          "最终选择"
        ]
      }
    }
  },

  "taskProgression": {
    "initialPool": {
      "requiredCompleted": 5,
      "unlockNextPool": true
    },

    "starPools": {
      "one": {
        "unlockCondition": {
          "type": "initial_tasks_completed",
          "operator": ">=",
          "value": 5
        },
        "dailyRandomCount": [
          1,
          3
        ]
      },

      "two": {
        "unlockCondition": {
          "type": "completed_tasks",
          "star": 1,
          "operator": ">=",
          "value": 10
        },
        "mixWithPrevious": true,
        "weightIncreaseByCompletion": true
      },

      "three": {
        "unlockCondition": {
          "type": "completed_tasks",
          "star": 2,
          "operator": ">=",
          "value": 10
        },

        "specialRequirement": {
          "type": "meeting_task_completed",
          "required": 1
        },

        "informationReveal": {
          "enabled": true,
          "targetLearns": [
            "controller_name_one_character",
            "controller_approximate_age",
            "first_meeting_location_type"
          ],
          "controllerLearns": [
            "target_name_one_character",
            "target_approximate_age",
            "first_meeting_location_type"
          ]
        }
      },

      "four": {
        "unlockCondition": {
          "type": "completed_tasks",
          "star": 3,
          "operator": ">=",
          "value": 8
        }
      },

      "five": {
        "unlockCondition": {
          "type": "completed_tasks",
          "star": 4,
          "operator": ">=",
          "value": 5
        }
      }
    },

    "noRegression": true,

    "mixingRule": {
      "enabled": true,
      "description": "已解锁星级不会因为更高星级解锁而消失，所有已解锁星级可继续混合推送。"
    },

    "generatedTaskCorruptionRange": {
      "one": [
        20,
        28
      ],
      "two": [
        30,
        38
      ],
      "three": [
        40,
        50
      ],
      "four": [
        50,
        58
      ],
      "five": [
        60,
        85
      ]
    }
  },

  "meetingProgression": {
    "completedCountVariable": "completedMeetingTasks",

    "requirements": {
      "threeStarReveal": 1,
      "bondUnlock": 3,
      "awakeningFinalChoice": 100
    },

    "postMeetingCheck": {
