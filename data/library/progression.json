  "stateTransitionRules": {
    "onTaskCompleted": [
      "increase_completed_tasks_total",
      "increase_completed_tasks_by_star",
      "increase_corruption",
      "update_consecutive_completion",
      "check_star_unlock",
      "check_bond",
      "check_final_choice"
    ],

    "onTaskRefused": [
      "increase_refusal_count",
      "reset_consecutive_completion",
      "draw_penalty",
      "check_refusal_milestone"
    ],

    "onTaskTimeout": [
      "increase_timeout_count",
      "reset_consecutive_completion",
      "apply_timeout_penalty",
      "increase_consecutive_timeout_days",
      "check_three_day_timeout_event"
    ],

    "onPrivateMessageReceived": [
      "increase_private_message_received",
      "check_same_day_message_and_task"
    ],

    "onPrivateMessageReply": [
      "increase_private_message_replied"
    ],

    "onMeetingCompleted": [
      "increase_completed_meeting_tasks",
      "increase_awareness_if_required",
      "perform_post_meeting_safety_check",
      "check_bond"
    ],

    "onAwakeningChange": [
      "recalculate_story_stage",
      "check_final_choice"
    ],

    "onCorruptionChange": [
      "recalculate_corruption_stage",
      "check_bond"
    ]
  },

  "aiBehaviorRules": {
    "description": "AI必须根据实时变量选择对应阶段的叙事方式，不得仅根据固定剧情文本生成。",

    "priority": [
      "current_story_stage",
      "awakening",
      "corruption",
      "controller_level",
      "current_task",
      "current_scene",
      "bond_state",
      "free_mode"
