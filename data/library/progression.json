        "condition": "awakening_41_60",
        "behavior": "允许角色主动关注任务和私信，同时增加心理矛盾。"
      },
      {
        "condition": "awakening_61_80",
        "behavior": "允许角色主动追踪、试探和记录规律。"
      },
      {
        "condition": "awakening_81_100",
        "behavior": "允许反向干扰、身份线索和终局伏笔逐渐出现。"
      }
    ],

    "corruptionRules": [
      {
        "condition": "corruption_0_20",
        "behavior": "保持明显抵触、羞耻或不安。"
      },
      {
        "condition": "corruption_21_40",
        "behavior": "增加对任务和私信的情绪关注。"
      },
      {
        "condition": "corruption_41_60",
        "behavior": "允许出现主动化行为与心理矛盾。"
      },
      {
        "condition": "corruption_61_80",
        "behavior": "增加依赖、回避现实社交以及共感影响。"
      },
      {
        "condition": "corruption_81_100",
        "behavior": "表现明显依赖与关系确认倾向。"
      }
    ],

    "important": [
      "沦陷值和觉醒度不是同一个变量。",
      "高沦陷不代表低觉醒。",
      "高觉醒不代表低沦陷。",
      "两者必须独立计算。",
