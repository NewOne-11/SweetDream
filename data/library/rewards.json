{
  "id": "rewards",
  "version": "1.0.0",
  "title": "奖励资料库",
  "description": "任务完成后的随机奖励池。",
  "databaseType": "static",

  "visibility": {
    "playerCanRead": true,
    "aiCanRead": true,
    "playerCanEdit": false,
    "adminCanEdit": true
  },

  "system": {
    "enabled": true,

    "selection": {
      "method": "weighted_random",
      "allowDuplicate": false,
      "respectUnlockConditions": true
    },

    "applyImmediately": true,

    "history": {
      "enabled": true,
      "saveToIndexedDB": true
    }
  },

  "rewardTypes": {
    "taskModifier": {
      "id": "taskModifier",
      "name": "任务调整",
      "description": "改变未来任务数量或任务安排。"
    },

    "skip": {
      "id": "skip",
      "name": "跳过权限",
      "description": "允许玩家跳过指定任务。"
    },

    "clue": {
      "id": "clue",
      "name": "剧情线索",
      "description": "解锁关于操控者或剧情的信息。"
    },

    "item": {
      "id": "item",
      "name": "物品奖励",
      "description": "获得物品库中的物品。"
    },

    "corruption": {
      "id": "corruption",
      "name": "沦陷值调整",
      "description": "改变当前沦陷值。"
    },

    "scene": {
      "id": "scene",
      "name": "场景解锁",
      "description": "解锁新的场景背景。"
    },

    "permission": {
      "id": "permission",
      "name": "特殊权限",
      "description": "获得一次性系统权限。"
    },

    "inventory": {
      "id": "inventory",
      "name": "背包扩容",
      "description": "增加背包容量。"
    },

    "freeDay": {
      "id": "freeDay",
      "name": "自由日",
      "description": "指定日期不生成任务。"
    }
  },

