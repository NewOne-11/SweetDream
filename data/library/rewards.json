  "aiRules": {
    "enabled": true,

    "canSelectReward": true,

    "mustRespect": [
      "current_star",
      "current_progression",
      "unlock_conditions",
      "inventory_capacity",
      "existing_items",
      "reward_history"
    ],

    "mustNot": [
      "invent_reward_id",
      "invent_item_id",
      "grant_locked_reward",
      "change_reward_effect",
      "duplicate_unique_reward_without_permission"
    ]
  },

  "history": {
    "enabled": true,
    "saveToIndexedDB": true,

    "recordFields": [
      "rewardId",
      "rewardType",
      "taskId",
      "star",
      "timestamp",
      "effectApplied"
    ]
  },

  "validation": {
    "enabled": true,

    "checks": [
      "unique_reward_id",
      "valid_reward_type",
      "valid_star_pool",
      "valid_effect",
      "item_reference_exists",
      "schema_valid"
    ]
  }
}
