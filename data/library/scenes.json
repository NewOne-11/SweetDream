{
  "id": "scenes",
  "version": 1,
  "title": "场景资料库",
  "description": "记录游戏中的地点、时间、风险等级、NPC数量、可用动作、可用物品及场景状态。",
  "type": "scene_library",
  "aiVisible": true,
  "playerVisible": true,

  "riskLevels": {
    "0": {
      "name": "无风险",
      "description": "私密安全环境，无任何暴露或打扰风险，可自由执行任意操作。"
    },
    "1": {
      "name": "极低风险",
      "description": "相对安全的半私密空间，外界打扰概率极低。"
    },
    "2": {
      "name": "低风险",
      "description": "低风险环境，通常指无人的公共或教学办公场所。"
    },
    "3": {
      "name": "中低风险",
      "description": "有极少数NPC活动的非直接视线区域。"
    },
    "4": {
      "name": "中等风险",
      "description": "中等强度的受控公共场所，随时可能面临目光掠过或打扰。"
    },
    "5": {
      "name": "中高风险",
      "description": "NPC较多但社交距离尚可的半公开场景。"
    },
    "6": {
      "name": "高风险",
      "description": "人员密集且存在流动性的公共社交环境。"
    },
    "7": {
      "name": "极高风险",
      "description": "极高暴露隐患，视线无死角的通勤或室外开放环境。"
    },
    "8": {
      "name": "危险",
      "description": "高密度暴露风险，随时有社会性死亡可能性的高危场所。"
    },
    "9": {
      "name": "极危险",
      "description": "极限挑战环境，任何微小失控都会立即导致暴露失败。"
    },
    "10": {
      "name": "最高风险",
      "description": "毫无防护的绝对公开场合，NPC注意度增长极快。"
    }
  },

