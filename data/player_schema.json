{
  "version": "1.1",

  "title": "主控角色创建",

  "sections": [

    {
      "id": "identity",
      "title": "① 基础身份",

      "fields": [

        {
          "id": "name",
          "title": "姓名",
          "type": "text",
          "path": "profile.identity.name"
        },

        {
          "id": "age",
          "title": "年龄",
          "type": "number",
          "path": "profile.identity.age"
        },

        {
          "id": "gender",
          "title": "生理性别",
          "type": "radio",
          "path": "profile.identity.gender",

          "options": [
            "女",
            "男",
            "双性"
          ]
        },

        {
          "id": "orientation",
          "title": "性取向",
          "type": "radio",
          "path": "profile.identity.orientation",

          "options": [
            "只对男性",
            "只对女性",
            "扶她",
            "都有"
          ]
        },

        {
          "id": "rolePreference",
          "title": "角色倾向",
          "type": "radio",
          "path": "profile.identity.rolePreference",

          "options": [
            "支配方(Dom/S)",
            "被支配方(Sub/M)",
            "平等方(Switch)"
          ]
        }

      ]
    },


    {
      "id": "appearance",
      "title": "② 外貌设定",

      "fields": [

        {
          "id": "hair",
          "title": "发型/发色",
          "type": "text",
          "path": "profile.appearance.hair"
        },

        {
          "id": "eyes",
          "title": "瞳色",
          "type": "text",
          "path": "profile.appearance.eyes"
        },

        {
          "id": "features",
          "title": "体表特征",

          "type": "textarea",

          "path": "profile.appearance.features"
        }

      ]
    },


    {
      "id": "bodyBasic",

      "title": "③ 基础身体参数",

      "fields": [

        {
          "id": "height",

          "title": "身高(cm)",

          "type": "number",

          "path": "body.basic.height"
        },


        {
          "id": "weight",

          "title": "体重(kg)",

          "type": "number",

          "path": "body.basic.weight"
        },


        {
          "id": "skin",

          "title": "肤色",

          "type": "select",

          "path": "body.basic.skin",

          "options": [

            "冷白皮",

            "粉白皮",

            "自然肤色",

            "健康小麦色",

            "深色巧克力"

          ]
        },


        {
          "id": "bodyType",

          "title": "体型",

          "type": "select",

          "path": "body.basic.bodyType",

          "options": [

            "纤细",

            "标准",

            "丰满",

            "肌肉线条",

            "肉感"

          ]
        }

      ]

    },


    {
      "id": "femaleBody",

      "title": "④ 女性身体特征",

      "condition": {

        "field": "profile.identity.gender",

        "values": [

          "女",

          "双性"

        ]

      },


      "fields": [

        {
          "id": "breastSize",

          "title": "乳房尺寸",

          "type": "select",

          "path": "body.female.breastSize",

          "options": [

            "A-B偏小",

            "C-D适中",

            "E-G丰满",

            "H及以上巨乳"

          ]
        },


        {
          "id": "areolaColor",

          "title": "乳晕颜色",

          "type": "select",

          "path": "body.female.areolaColor",

          "options": [

            "粉嫩色",

            "浅褐色",

            "深褐色"

          ]
        },


        {
          "id": "privateAppearance",

          "title": "私处外观",

          "type": "select",

          "path": "body.female.privateAppearance",

          "options": [

            "鲍鱼型",

            "蝴蝶型",

            "馒头型"

          ]
        },


        {
          "id": "bodyHair",

          "title": "私处毛发",

          "type": "select",

          "path": "body.female.bodyHair",

          "options": [

            "光洁无毛",

            "精心修剪",

            "自然状态"

          ]
        }

      ]

    },


    {
      "id": "maleBody",

      "title": "⑤ 男性身体特征",

      "condition": {

        "field": "profile.identity.gender",

        "values": [

          "男",

          "双性"

        ]

      },


      "fields": [

        {
          "id": "length",

          "title": "长度(cm)",

          "type": "number",

          "path": "body.male.length"
        },


        {
          "id": "girth",

          "title": "粗度(cm)",

          "type": "number",

          "path": "body.male.girth"
        },


        {
          "id": "shape",

          "title": "形态",

          "type": "select",

          "path": "body.male.shape",

          "options": [

            "笔直标准",

            "微上翘",

            "微下弯"

          ]
        }

      ]

    },


    {
      "id": "psychology",

      "title": "⑥ 生理与心理参数",

      "fields": [

        {
          "id": "sensitivity",

          "title": "整体敏感度",

          "type": "radio",

          "path": "psychology.sensitivity.level",

          "options": [

            "极易敏感",

            "较敏感",

            "中等",

            "偏低"

          ]
        },


        {
          "id": "areas",

          "title": "敏感部位",

          "type": "checkbox",

          "path": "psychology.sensitivity.areas",

          "options": [

            "耳/颈",

            "乳尖/胸",

            "腰/腹",

            "大腿内侧",

            "阴部",

            "后庭"

          ]
        },


        {
          "id": "shame",

          "title": "羞耻感",

          "type": "radio",

          "path": "psychology.shame",

          "options": [

            "容易羞耻",

            "中等",

            "不易羞耻"

          ]
        },


        {
          "id": "endurance",

          "title": "耐力",

          "type": "radio",

          "path": "psychology.endurance",

          "options": [

            "持久型",

            "中等",

            "耐力较差"

          ]
        }

      ]

    },


    {
      "id": "preferences",

      "title": "⑦ 偏好设置",

      "fields": [

        {
          "id": "triggers",

          "title": "容易触发的互动因素",

          "type": "checkbox",

          "path": "preferences.triggers",

          "options": [

            "被抚摸特定部位",

            "被压制/控制",

            "言语挑逗/命令",

            "对方强势",

            "疼痛感",

            "被多人注视",

            "羞辱/贬低",

            "温柔照顾/宠溺",

            "制服/正装",

            "其他"

          ]
        }

      ]

    },


    {
      "id": "limits",

      "title": "⑧ 明确排斥项",

      "fields": [

        {
          "id": "limits",

          "title": "排斥内容",

          "type": "checkbox",

          "path": "limits.items",

          "options": [

            "无",

            "血腥/暴力",

            "排泄物相关",

            "永久性伤害",

            "窒息/极限控制",

            "穿刺/针",

            "呕吐",

            "兽交",

            "公共场所露出",

            "多人",

            "其他"

          ]
        },


        {
          "id": "custom",

          "title": "其他补充",

          "type": "textarea",

          "path": "limits.custom"

        }

      ]

    }

  ]
}
